POSTGRES_DB=damoyeo
POSTGRES_USER=damoyeo
POSTGRES_PASSWORD=damoyeo
POSTGRES_PORT=5432
BACKEND_PORT=8080
# 기본값은 GHCR의 latest 이미지이며, 특정 태그를 검증할 때만 바꿉니다.
BACKEND_IMAGE=ghcr.io/damoyeo-team20/damoyeo-be:latest

# 소스로 백엔드를 실행할 때의 DB 접속 정보입니다.
# Compose의 backend 컨테이너는 자동으로 postgres:5432를 사용합니다.
DB_URL=jdbc:postgresql://localhost:5432/damoyeo
DB_USERNAME=damoyeo
DB_PASSWORD=damoyeo

# 로컬 FastAPI는 0.0.0.0:8000으로 실행하면 backend 컨테이너가 접속할 수 있습니다.
AI_PORT=8000
INTERNAL_API_KEY=local-ai-key
